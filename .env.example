# Copy to .env and fill in. Never commit .env.
# Free TomTom developer key: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Service role key (server-side only). Do not put this in a browser app or public repo.
SUPABASE_SERVICE_ROLE_KEY=
